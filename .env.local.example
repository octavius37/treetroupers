# Local development against the Supabase stack in docker-compose.yml.
#
#   cp .env.local.example .env
#
# These are NOT secrets. The local Supabase stack signs its JWTs with a fixed,
# published demo secret, so these exact strings are identical on every machine
# running `supabase start`. They are useless against any hosted project, which
# is why this file is committed while `.env` is not.
#
# Verified against `supabase status -o env` for this project's config.toml.

SUPABASE_URL=http://127.0.0.1:54421

# anon key — role: anon (RLS applies)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# service_role key — bypasses RLS. `@nuxtjs/supabase` reads SUPABASE_SERVICE_KEY
# for serverSupabaseServiceRole(); SUPABASE_SECRET_KEY mirrors the name used in
# .env.example so either spelling resolves.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Auth
NUXT_URL=http://localhost:3000
AUTH_SECRET=local-development-only-secret-min-32-chars

# Seeded logins (both password123):
#   admin@example.com  -> role 'admin', can reach /dashboard/cms
#   member@example.com -> role 'user'
#
# Local Studio:      http://127.0.0.1:54423
# Captured email:    http://127.0.0.1:54424

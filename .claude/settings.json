{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-setup.sh",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-setup.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}

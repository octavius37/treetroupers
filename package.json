{
  "name": "tree-troupers",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:fix": "eslint . --fix",
    "lint": "oxlint --deny-warnings -D correctness -D suspicious -D perf && eslint --max-warnings 0 .",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > app/types/database.types.ts",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.4",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "grapesjs": "^0.23.2",
    "grapesjs-blocks-basic": "^1.0.2",
    "next-auth": "4.21.1",
    "nuxt": "4.1.2",
    "superjson": "^2.2.2",
    "trpc-nuxt": "^1.2.0",
    "vue": "3.5.22",
    "vue-router": "4.5.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@bg-dev/nuxt-naiveui": "2.0.0",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@sidebase/nuxt-auth": "^1.1.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.37.0",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.20.0",
    "supabase": "^2.111.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@supabase/ssr": {
      "cookie": "0.7.2"
    }
